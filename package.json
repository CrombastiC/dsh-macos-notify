{
  "name": "dsh-macos-notify",
  "version": "0.4.1",
  "description": "Native macOS notifications and configurable sounds for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "src/policy.js", "src/state.js", "cordis.patch.yml"],
  "keywords": ["dsh-plugin", "deepseek-harness", "macos", "notifications"],
  "author": "CrombastiC",
  "license": "MIT",
  "homepage": "https://github.com/CrombastiC/dsh-macos-notify#readme",
  "bugs": {
    "url": "https://github.com/CrombastiC/dsh-macos-notify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrombastiC/dsh-macos-notify.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "node --check index.js && node --check client.js && node --check src/policy.js && node --check src/state.js && npm test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
